{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "persistence", "config"],
  "properties": {
    "replicaCount": {"type": "integer", "const": 1},
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^$|^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {"type": "object"},
    "existingConfigSecret": {"type": "string"},
    "bootstrapUsersFile": {"type": "boolean"},
    "persistence": {
      "type": "object",
      "properties": {
        "existingClaim": {"type": "string"},
        "size": {"type": "string", "minLength": 1},
        "accessModes": {"type": "array", "minItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod"]}}
      }
    },
    "env": {"type": "array"},
    "envFrom": {"type": "array"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "service": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}}
  }
}
