import { LogPick, Theme } from "@laminara/contract.slint";
import { Look } from "look.slint";

export component LogLine inherits Rectangle {
    in property <int> index;
    in property <string> text;
    in property <styled-text> rich;
    in property <bool> hit;
    in property <int> level;
    property <color> ink: root.level == 0 ? Look.dim : root.level == 1 ? Look.text.with-alpha(0.85) : root.level == 2 ? Look.warn : Look.danger;
    property <bool> under: LogPick.dragging && LogPick.drag-y >= self.absolute-position.y && LogPick.drag-y < self.absolute-position.y + self.height;
    changed under => {
        if self.under {
            LogPick.focus = root.index;
        }
    }
    background: LogPick.holds(root.index) ? Theme.primary.with-alpha(0.18) : root.level == 3 ? Look.danger.with-alpha(0.07) : transparent;
    if root.level == 3: Rectangle {
        x: 0;
        width: 2px;
        background: Look.danger;
    }
    pick := TouchArea {
        mouse-cursor: MouseCursor.text;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                if !(event.modifiers.shift && LogPick.anchor >= 0) {
                    LogPick.anchor = root.index;
                }
                LogPick.focus = root.index;
                LogPick.drag-y = self.absolute-position.y + self.mouse-y;
                LogPick.dragging = true;
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                LogPick.dragging = false;
            }
        }
        moved => {
            if self.pressed {
                LogPick.drag-y = self.absolute-position.y + self.mouse-y;
            }
        }
    }
    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        if !root.hit: Text {
            text: root.text;
            font-family: Look.mono;
            font-size: 12px;
            line-height-factor: Look.log-line / (12px * Look.mono-natural);
            wrap: word-wrap;
            color: root.ink;
        }
        if root.hit: StyledText {
            text: root.rich;
            default-font-family: Look.mono;
            default-font-size: 12px;
            default-color: root.ink;
        }
    }
}
